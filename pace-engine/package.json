{
  "name": "@pace-sdk/engine",
  "version": "0.1.0",
  "description": "Rust-powered rate limiting engine for Pace",
  "main": "index.js",
  "files": [
    "index.js",
    "*.node"
  ],
  "scripts": {
    "build": "cargo build --release && napi build --platform --release",
    "prepublishOnly": "napi prepublish -t npm"
  },
  "napi": {
    "binaryName": "index",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^3.6.2"
  },
  "optionalDependencies": {
    "@pace-sdk/engine-linux-x64-gnu": "0.1.0",
    "@pace-sdk/engine-linux-arm64-gnu": "0.1.0",
    "@pace-sdk/engine-darwin-x64": "0.1.0",
    "@pace-sdk/engine-darwin-arm64": "0.1.0",
    "@pace-sdk/engine-win32-x64-msvc": "0.1.0"
  }
}