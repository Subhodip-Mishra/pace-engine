{
  "name": "@pace-sdk/engine",
  "version": "0.1.0",
  "description": "Rust-powered rate limiting engine for Pace",
  "main": "index.js",
  "files": ["index.js", "*.node"],
  "scripts": {
    "build": "cargo build --release && napi build --platform --release",
    "prepublishOnly": "napi prepublish -t npm"
  },
  "napi": {
    "name": "pace-engine",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "license": "MIT"
}
